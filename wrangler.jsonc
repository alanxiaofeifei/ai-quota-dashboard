{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "ai-quota-dashboard", "main": "worker/index.ts", "compatibility_date": "2026-11-15",
 "workers_dev": false, "preview_urls": false,
 "assets": {"directory": "dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true},
 "d1_databases": [{"binding": "DB", "database_name": "ai-quota-dashboard", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
 "observability": {"enabled": true, "head_sampling_rate": 0.1, "traces": {"enabled": true, "head_sampling_rate": 0.1}}
}
